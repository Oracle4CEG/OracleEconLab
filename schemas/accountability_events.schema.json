{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oracle-accountability-atlas.local/schemas/accountability-events-1.0.0.json",
  "title": "Oracle Accountability Event",
  "type": "object",
  "required": [
    "schema_version",
    "accountability_event_id",
    "oracle_network",
    "mechanism_family",
    "security_chain",
    "accountability_unit_type",
    "accountability_unit_id",
    "event_granularity",
    "truth_basis",
    "outcome_status",
    "external_truth_available",
    "source_event",
    "rule_id",
    "observability_grade",
    "confidence_grade",
    "native_table"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "accountability_event_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "oracle_network": {"type": "string"},
    "mechanism_family": {"type": "string"},
    "security_chain": {"type": "string"},
    "delivery_chain": {"type": ["string", "null"]},
    "accountability_unit_type": {
      "enum": ["request", "individual_report", "dispute", "voting_request", "voting_epoch", "reward_epoch", "publisher_pool_epoch", "service_availability_window"]
    },
    "accountability_unit_id": {"type": "string"},
    "event_granularity": {"type": "string"},
    "event_time_unix": {"type": ["integer", "null"]},
    "actor": {"type": ["string", "null"]},
    "actor_role": {"type": ["string", "null"]},
    "counterparty": {"type": ["string", "null"]},
    "counterparty_role": {"type": ["string", "null"]},
    "reward_class": {"type": ["string", "null"]},
    "reward_amount_raw": {"$ref": "#/$defs/rawAmount"},
    "reward_asset": {"type": ["string", "null"]},
    "reward_asset_decimals": {"type": ["integer", "null"]},
    "reward_accrual_time_unix": {"type": ["integer", "null"]},
    "reward_payment_time_unix": {"type": ["integer", "null"]},
    "penalty_class": {"type": ["string", "null"]},
    "principal_slashed_raw": {"$ref": "#/$defs/rawAmount"},
    "bond_forfeited_raw": {"$ref": "#/$defs/rawAmount"},
    "fee_forfeited_raw": {"$ref": "#/$defs/rawAmount"},
    "reward_forfeited_raw": {"$ref": "#/$defs/rawAmount"},
    "penalty_asset": {"type": ["string", "null"]},
    "penalty_asset_decimals": {"type": ["integer", "null"]},
    "nonmonetary_penalty": {"type": ["string", "null"]},
    "principal_locked_raw": {"$ref": "#/$defs/rawAmount"},
    "principal_returned_raw": {"$ref": "#/$defs/rawAmount"},
    "principal_asset": {"type": ["string", "null"]},
    "principal_asset_decimals": {"type": ["integer", "null"]},
    "truth_basis": {
      "enum": ["undisputed_acceptance", "protocol_vote_adjudication", "consensus_median_alignment", "independent_reference_adjudication", "service_availability_condition", "external_ground_truth"]
    },
    "outcome_status": {"type": "string"},
    "external_truth_available": {"type": "boolean"},
    "service_window_seconds": {"type": ["integer", "null"]},
    "service_threshold_seconds": {"type": ["integer", "null"]},
    "source_event": {"type": "string"},
    "source_tx": {"type": ["string", "null"]},
    "source_block": {"type": ["integer", "null"]},
    "source_log_index": {"type": ["integer", "null"]},
    "source_contract": {"type": ["string", "null"]},
    "rule_id": {"type": "string"},
    "parameter_version": {"type": ["string", "null"]},
    "observability_grade": {"enum": ["A", "B", "C", "U"]},
    "confidence_grade": {"enum": ["A", "B", "C", "U"]},
    "native_table": {"type": "string"},
    "sample_tier": {"type": ["string", "null"]},
    "interpretation_note": {"type": ["string", "null"]}
  },
  "$defs": {
    "rawAmount": {"type": ["string", "null"], "pattern": "^-?[0-9]+$"}
  },
  "additionalProperties": false
}
