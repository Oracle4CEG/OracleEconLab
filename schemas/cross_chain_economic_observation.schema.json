{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oracle-econ-atlas.local/schemas/cross-chain-economic-observation-1.0.0.json",
  "title": "Cross-chain oracle economic observation",
  "description": "A decision- or lifecycle-level economic observation with transaction-level provenance and decision-time evidence controls.",
  "type": "object",
  "required": [
    "schema_version",
    "episode_id",
    "protocol",
    "mechanism",
    "observation_unit",
    "security_chain_namespace",
    "security_chain_id",
    "decision_time_unix",
    "action",
    "terminal_outcome",
    "right_censored",
    "source_finality_rule",
    "provenance_id",
    "coverage_status",
    "validation_status"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "episode_id": {"type": "string", "minLength": 1},
    "protocol": {"type": "string", "minLength": 1},
    "mechanism": {"type": "string", "minLength": 1},
    "native_unit_type": {"type": ["string", "null"]},
    "observation_unit": {
      "enum": ["request", "actor_episode", "proposal", "dispute", "vote", "epoch", "service_window", "cross_chain_episode"]
    },
    "security_chain_namespace": {"type": "string", "description": "CAIP-2 namespace, e.g. eip155 or solana."},
    "security_chain_id": {"type": "string", "minLength": 1},
    "delivery_chain_namespace": {"type": ["string", "null"]},
    "delivery_chain_id": {"type": ["string", "null"]},
    "actor": {"type": ["string", "null"]},
    "actor_role": {"type": ["string", "null"]},
    "counterparty": {"type": ["string", "null"]},
    "counterparty_role": {"type": ["string", "null"]},
    "decision_time_unix": {"type": ["integer", "null"], "minimum": 0},
    "proposal_time_unix": {"type": ["integer", "null"], "minimum": 0},
    "dispute_time_unix": {"type": ["integer", "null"], "minimum": 0},
    "settlement_time_unix": {"type": ["integer", "null"], "minimum": 0},
    "challenge_deadline_unix": {"type": ["integer", "null"], "minimum": 0},
    "terminal_time_unix": {"type": ["integer", "null"], "minimum": 0},
    "action": {"enum": ["accept", "investigate", "challenge", "abstain", "protocol_observed_action", "not_applicable"]},
    "terminal_outcome": {"type": "string", "minLength": 1},
    "right_censored": {"type": "boolean"},
    "independent_ground_truth": {"type": ["string", "null"]},
    "ground_truth_status": {"enum": ["available", "protocol_resolution_only", "ambiguous", "unavailable", "not_applicable"]},
    "asset_address": {"type": ["string", "null"]},
    "asset_symbol": {"type": ["string", "null"]},
    "asset_decimals": {"type": ["integer", "null"], "minimum": 0},
    "bond_raw": {"$ref": "#/$defs/rawAmount"},
    "reward_configured_raw": {"$ref": "#/$defs/rawAmount"},
    "reward_paid_raw": {"$ref": "#/$defs/rawAmount"},
    "reward_forfeited_raw": {"$ref": "#/$defs/rawAmount"},
    "principal_returned_raw": {"$ref": "#/$defs/rawAmount"},
    "bond_forfeited_raw": {"$ref": "#/$defs/rawAmount"},
    "final_fee_forfeited_raw": {"$ref": "#/$defs/rawAmount"},
    "principal_slashed_raw": {"$ref": "#/$defs/rawAmount"},
    "protocol_fee_raw": {"$ref": "#/$defs/rawAmount"},
    "gross_payout_raw": {"$ref": "#/$defs/rawAmount"},
    "realized_payoff_raw": {"$ref": "#/$defs/rawAmount"},
    "gas_cost_native_raw": {"$ref": "#/$defs/rawAmount"},
    "investigation_cost_usd": {"$ref": "#/$defs/decimalAmount"},
    "delay_cost_usd": {"$ref": "#/$defs/decimalAmount"},
    "capital_cost_usd": {"$ref": "#/$defs/decimalAmount"},
    "usd_value": {"$ref": "#/$defs/decimalAmount"},
    "usd_conversion_source": {"type": ["string", "null"]},
    "usd_conversion_time_unix": {"type": ["integer", "null"], "minimum": 0},
    "reward_to_bond_ratio": {"$ref": "#/$defs/decimalAmount"},
    "dispute_decision": {"type": ["boolean", "null"]},
    "proposal_upheld": {"type": ["boolean", "null"]},
    "mandatory_wait_seconds": {"type": ["integer", "null"], "minimum": 0},
    "resolution_delay_seconds": {"type": ["integer", "null"], "minimum": 0},
    "settlement_delay_seconds": {"type": ["integer", "null"], "minimum": 0},
    "excess_delay_seconds": {"type": ["integer", "null"], "minimum": 0},
    "capital_days_locked_raw": {"$ref": "#/$defs/decimalAmount"},
    "verification_cost_usd": {"$ref": "#/$defs/decimalAmount"},
    "economic_regret_usd": {"$ref": "#/$defs/decimalAmount"},
    "independent_ground_truth_available": {"type": ["boolean", "null"]},
    "dvm_positive_redistribution_raw": {"$ref": "#/$defs/rawAmount"},
    "dvm_negative_slash_raw": {"$ref": "#/$defs/rawAmount"},
    "decision_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_snapshot_time_unix": {"type": ["integer", "null"], "minimum": 0},
    "future_fields_excluded": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source_chain_namespace": {"type": ["string", "null"]},
    "source_chain_id": {"type": ["string", "null"]},
    "source_contract": {"type": ["string", "null"]},
    "source_transaction": {"type": ["string", "null"]},
    "source_log_index": {"type": ["integer", "null"], "minimum": 0},
    "source_block_number": {"type": ["integer", "null"], "minimum": 0},
    "source_block_timestamp_unix": {"type": ["integer", "null"], "minimum": 0},
    "source_event": {"type": ["string", "null"]},
    "source_table": {"type": "string", "minLength": 1},
    "source_finality_rule": {"type": "string", "minLength": 1},
    "cross_chain_link_grade": {"enum": ["A", "B", "C", "U", "not_applicable"]},
    "provenance_id": {"type": "string", "minLength": 1},
    "prov_entity_id": {"type": ["string", "null"]},
    "prov_activity_id": {"type": ["string", "null"]},
    "prov_agent_id": {"type": ["string", "null"]},
    "transformation_rule_id": {"type": ["string", "null"]},
    "contract_semantics_rule_id": {"type": ["string", "null"]},
    "coverage_status": {"enum": ["complete", "partial", "verified_zero", "unknown", "unavailable", "not_applicable"]},
    "missing_reason": {"type": ["string", "null"]},
    "evidence_grade": {"enum": ["A", "B", "C", "U"]},
    "validation_status": {"enum": ["passed", "failed", "pending", "not_applicable"]},
    "validation_rule_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "interpretation_note": {"type": ["string", "null"]}
  },
  "$defs": {
    "rawAmount": {"type": ["string", "null"], "pattern": "^-?[0-9]+$"},
    "decimalAmount": {"type": ["string", "null"], "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"}
  },
  "allOf": [
    {
      "if": {"properties": {"right_censored": {"const": true}}, "required": ["right_censored"]},
      "then": {"properties": {"terminal_time_unix": {"type": "null"}}}
    },
    {
      "if": {"properties": {"usd_value": {"type": "string"}}, "required": ["usd_value"]},
      "then": {"required": ["usd_conversion_source", "usd_conversion_time_unix"]}
    }
  ],
  "additionalProperties": false
}
