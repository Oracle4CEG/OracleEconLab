  "creator": {
    "@type": "sc:Organization",
    "name": "Oracle4CEG"
  },
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "raw_events",
      "name": "uma_demo_event_log.csv",
      "description": "Raw synthetic event records",
      "contentUrl": "https://raw.githubusercontent.com/sunshineluyao/OracleEconLab/main/data/raw/uma_demo_event_log.csv",
      "encodingFormat": "text/csv",
      "sha256": "aeb33d34aea678983226b0fa850ea5615e31a02a475e51e9710ce8ff20d43d97"
    },
    {
      "@type": "cr:FileObject",
      "@id": "source_registry",
      "name": "source_registry.csv",
      "description": "Source and provenance registry",
      "contentUrl": "https://raw.githubusercontent.com/sunshineluyao/OracleEconLab/main/data/source_registry.csv",
      "encodingFormat": "text/csv",
      "sha256": "ebbc3c5f384c1220ee3bef6727fadbcf8b17be0ceb4256ed859337a6f564bdf0"
    },
    {
      "@type": "cr:FileObject",
      "@id": "processed_episodes",
      "name": "uma_economic_episodes.csv",
      "description": "Processed economic episode table",
      "contentUrl": "https://raw.githubusercontent.com/sunshineluyao/OracleEconLab/main/data/processed/uma_economic_episodes.csv",
      "encodingFormat": "text/csv",
      "sha256": "16cf328462ee292e9d662044390230c90b35026b376e61effa5b728e8a71aab8"
    },
    {
      "@type": "cr:FileObject",
      "@id": "summary",
      "name": "summary.csv",
      "description": "Reproduced descriptive metrics",
      "contentUrl": "https://raw.githubusercontent.com/sunshineluyao/OracleEconLab/main/outputs/summary.csv",
      "encodingFormat": "text/csv",
      "sha256": "7b1c2b6f73fc05994b826896201669dce9e5b9c3aad379122f46169921d59ed1"
    },
    {
      "@type": "cr:FileObject",
      "@id": "research_questions",
      "name": "research_questions.csv",
      "description": "Research-question and data-gap registry",
      "contentUrl": "https://raw.githubusercontent.com/sunshineluyao/OracleEconLab/main/outputs/research_questions.csv",
      "encodingFormat": "text/csv",
      "sha256": "4cb060a5e64b9f00473c25f7d62c2fd82b118cc4b5c0380baab8eea74b55e152"
    }
